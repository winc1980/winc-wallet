{
	"name": "winc-wallet",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "biome check",
		"typecheck": "bunx tsc --noEmit",
		"fix": "biome check --fix --unsafe",
		"dev": "react-router dev",
		"build": "react-router build",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"deploy": "bun run build && wrangler deploy",
		"preview": "vite preview",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:custom": "drizzle-kit generate --custom",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "bunx auth@latest generate --config ./auth.cli.ts --output ./app/db/schema/auth.ts -y && bun run fix ./app/db/schema/auth.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@cloudflare/vite-plugin": "^1.63.0",
		"@google/genai": "^2.28.0",
		"@hono/zod-validator": "^0.9.1",
		"@tailwindcss/vite": "^4.3.3",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"isbot": "^5.2.2",
		"lucide-react": "^1.55.0",
		"pg": "^8.23.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"react-router-hono-server": "^4.1.4",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "^5.20261008.1",
		"@react-router/dev": "^8.4.0",
		"@tsconfig/node26": "^26.0.1",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.11",
		"vite": "^8.3.3",
		"wrangler": "^4.149.0"
	}
}
